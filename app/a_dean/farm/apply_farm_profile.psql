-- Run with psql against the intended database after notification_system.sql
-- and setup/farm_setup_wizard_columns.sql have been deployed.
-- Relative includes resolve from this file, regardless of the working directory.
\set ON_ERROR_STOP on
begin;
\ir ../../sql/updated/farm_profile_columns.sql
\ir ../../sql/updated/farm_void_rls.sql
\ir ../../sql/updated/insert_farm_setup_wizard.sql
\ir ../../sql/updated/update_farm_setup_wizard.sql
commit;
